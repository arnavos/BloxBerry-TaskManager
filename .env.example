# =================================================================
# Bloxberry Labs PM Bot — Environment Configuration
# ZERO-EXTERNAL-DATABASE ARCHITECTURE (Discord Channel Storage: #bloxpilot-storage)
# =================================================================

# 1. Discord Bot Token (ONLY REQUIRED SECRET)
# Obtain from: https://discord.com/developers/applications -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# 2. Discord Guild ID (OPTIONAL - strongly recommended)
# Right-click your Bloxberry Labs server in Discord (Developer Mode on) -> Copy Server ID
# When set, slash commands register instantly to this server on boot.
DISCORD_GUILD_ID=your_bloxberry_labs_guild_id

# -----------------------------------------------------------------
# Runtime & Server Settings (Sensible Defaults — normally leave as is)
# -----------------------------------------------------------------
# PORT is automatically injected by Render (default: 3000 locally)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Timezone for deadline countdowns and due-today calculations
DEFAULT_TIMEZONE=Asia/Kolkata

# Automatically register/update slash commands on startup
DEPLOY_COMMANDS_ON_BOOT=true

# Scheduler interval in milliseconds (default: 30 seconds)
DEADLINE_CHECK_INTERVAL_MS=30000

# Delay in minutes before escalating overdue tasks to authorised management
MANAGEMENT_OVERDUE_REMINDER_DELAY_MINUTES=120
